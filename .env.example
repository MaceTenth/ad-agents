# Copy this file to .env and fill it in:   cp .env.example .env
# .env is ignored by git. Never commit it, never paste it into a chat.
# In the cloud (Railway, DigitalOcean) there is no .env: add the same names and values as service variables.

# ─── Required ──────────────────────────────────────────────────────────────────
# The password for the web page and the API (any user name). Use a long random one: anyone who has
# the URL and the password can spend your API credit.
APP_PASSWORD=
# https://platform.claude.com → API keys. Used by the research agent (and by `npm run agents:apply`).
ANTHROPIC_API_KEY=
# Pictures: openai (needs OPENAI_API_KEY) or gemini (needs GEMINI_API_KEY)
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── The agent ─────────────────────────────────────────────────────────────────
# Leave empty when claude-lock.json is committed: the IDs are read from it. Otherwise paste what
# `npm run agents:ids` prints.
AD_AGENT_ID=
AD_ENVIRONMENT_ID=

# ─── Cost control (defaults shown) ─────────────────────────────────────────────
# Hard spending cap per agent session at list prices, in cents (300 = $3)
AD_SESSION_BUDGET_CENTS=300
# Agent runs (new ads + revisions) allowed in 24 hours, and at the same time
MAX_RUNS_PER_DAY=30
MAX_PARALLEL_RUNS=2
# Briefs the checks may send back in one run before the agent must stop and explain (the course rule: 3)
MAX_REJECTIONS=3

# ─── Optional ──────────────────────────────────────────────────────────────────
# Defaults: gpt-image-2.6-sunburst (openai) or gemini-nano-banana-2.1 (gemini), quality medium
IMAGE_MODEL=
IMAGE_QUALITY=medium
# The time zone used for "today" in the facts block
TIMEZONE=Asia/Jerusalem
# Seconds before a stuck agent run is interrupted
AD_TURN_TIMEOUT_SECONDS=420
